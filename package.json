{
  "name": "obsidian-wasm-image",
  "version": "0.4.1",
  "description": "Fast image to WebP conversion using WebAssembly for Obsidian",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "webp",
    "image",
    "conversion",
    "webassembly",
    "wasm"
  ],
  "author": "KawaNae",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KawaNae/Obsidian-wasm-image-converter.git"
  },
  "devDependencies": {
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.23.0",
    "obsidian": "latest",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@jsquash/webp": "1.4.0",
    "safe-chain-test": "^0.0.1-security"
  }
}
